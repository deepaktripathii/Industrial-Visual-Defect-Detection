# Copy to .env and adjust as needed.

# --- storage ---------------------------------------------------------------
DEFECTIQ_DATA_DIR=./data
DEFECTIQ_DATASET_DIR=./data/demo_dataset
DEFECTIQ_ARTIFACT_DIR=./artifacts
DEFECTIQ_UPLOAD_DIR=./data/uploads

# SQLite by default; PostgreSQL for a shared deployment:
# DEFECTIQ_DATABASE_URL=postgresql+psycopg://defectiq:defectiq@localhost:5432/defectiq
DEFECTIQ_DATABASE_URL=sqlite:///./data/defectiq.db

# --- training --------------------------------------------------------------
DEFECTIQ_IMAGE_SIZE=224
DEFECTIQ_BATCH_SIZE=32
DEFECTIQ_NUM_WORKERS=0
DEFECTIQ_EPOCHS=8
DEFECTIQ_LEARNING_RATE=0.0001
DEFECTIQ_WEIGHT_DECAY=0.0001
DEFECTIQ_FREEZE_EPOCHS=1
DEFECTIQ_SEED=42
# auto | cpu | cuda | mps
DEFECTIQ_DEVICE=auto

# --- inference -------------------------------------------------------------
DEFECTIQ_DEFECTIVE_THRESHOLD=0.5
DEFECTIQ_MAX_UPLOAD_MB=10

# --- dashboard -------------------------------------------------------------
DEFECTIQ_API_URL=http://localhost:8000
DEFECTIQ_LOG_LEVEL=INFO
