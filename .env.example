# Copy to .env and adjust as needed.

# --- storage ---------------------------------------------------------------
DEFECT_DATA_DIR=./data
DEFECT_DATASET_DIR=./data/demo_dataset
DEFECT_ARTIFACT_DIR=./artifacts
DEFECT_UPLOAD_DIR=./data/uploads

# SQLite by default; PostgreSQL for a shared deployment:
# DEFECT_DATABASE_URL=postgresql+psycopg://defect_detection:defect_detection@localhost:5432/defect_detection
DEFECT_DATABASE_URL=sqlite:///./data/defect_detection.db

# --- training --------------------------------------------------------------
DEFECT_IMAGE_SIZE=224
DEFECT_BATCH_SIZE=32
DEFECT_NUM_WORKERS=0
DEFECT_EPOCHS=8
DEFECT_LEARNING_RATE=0.0001
DEFECT_WEIGHT_DECAY=0.0001
DEFECT_FREEZE_EPOCHS=1
DEFECT_SEED=42
# auto | cpu | cuda | mps
DEFECT_DEVICE=auto

# --- inference -------------------------------------------------------------
DEFECT_DEFECTIVE_THRESHOLD=0.5
DEFECT_MAX_UPLOAD_MB=10

# --- dashboard -------------------------------------------------------------
DEFECT_API_URL=http://localhost:8000
DEFECT_LOG_LEVEL=INFO
